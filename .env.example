# ============================================================
# Environment & Configuration Template (.env.example)
# Placeholders ONLY - Do NOT place real production secrets here.
# ============================================================

# Application & Security
SECRET_KEY=your-production-secret-key-here

# Database Configuration
POSTGRES_HOST=postgres-host
POSTGRES_PORT=5432
MLOPS_DB_NAME=mlops
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://mlflow-host:5000
MLFLOW_USERNAME=your_mlflow_user
MLFLOW_PASSWORD=your_mlflow_password

# Airflow Workflow Orchestrator
AIRFLOW_USERNAME=your_airflow_user
AIRFLOW_PASSWORD=your_airflow_password
AIRFLOW_WEBSERVER_HOST_PORT=8080

# Monitoring Scheduler Context
MONITORING_INTERVAL=300
MONITORING_LOOKBACK=24
